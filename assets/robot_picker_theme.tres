[resource]
default_font = SubResource("BoardFont")
default_font_size = 22
Button/colors/font_color = Color(1, 0.93, 0.76, 1)
Button/fonts/font = SubResource("BoardHeading")
Button/styles/normal = SubResource("DoneButton")
