[gd_resource type="Theme" format=3]

[ext_resource type="Texture2D" path="res://assets/robot_picker_frame.png" id="1_frame"]
[ext_resource type="Texture2D" path="res://assets/robot_picker_switch.svg" id="2_switch"]

[sub_resource type="SystemFont" id="BoardFont"]
